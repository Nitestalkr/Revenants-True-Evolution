{
  "name": "revenants",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "OpenClaw companion evolution plugin for GNW/GRAO monitoring and LibraVDB promotion signals.",
  "main": "index.mjs",
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ]
  },
  "scripts": {
    "test": "node ../tests/js/validate-monitor-suite.js && node ../tests/js/validate-context-engine.js && node ../tests/js/validate-companion-mode.js && node ../tests/js/validate-plugin-boundaries.js && node ../tests/js/validate-proposal-notifications.js",
    "test:plugin-native": "node ../tests/js/validate-plugin-native-runtime.js && node ../tests/js/validate-observer-status-reconciliation.js",
    "test:cron-guard": "node ../tests/js/validate-cron-historical-only.js",
    "ci": "npm test && npm run test:plugin-native && npm run test:cron-guard"
  }
}
